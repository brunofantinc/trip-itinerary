---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  subtitle?: string;
  variant?: 'default' | 'hero';
}

const { title, subtitle, variant = 'default' } = Astro.props;
const base = import.meta.env.BASE_URL;
const isHero = variant === 'hero';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f2ea" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Cormorant+Garamond:ital,wght@1,400;1,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Portugal Trip</title>
  </head>
  <body class:list={[isHero ? '' : 'mx-auto max-w-xl px-5 pb-24 pt-20 sm:px-8']}>
    <Nav pageTitle={isHero ? undefined : title} />
    {isHero ? (
      <slot />
    ) : (
      <>
        {subtitle && (
          <p class="mb-8 mt-2 text-[15px] text-[color:var(--color-muted)]">{subtitle}</p>
        )}
        <main>
          <slot />
        </main>
        <footer class="mt-20 border-t border-[color:var(--color-line)] pt-6 text-xs text-[color:var(--color-muted)]">
          <p>besties + 1</p>
        </footer>
      </>
    )}
  </body>
</html>
