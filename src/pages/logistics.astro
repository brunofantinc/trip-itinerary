---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { trip } from '../data/trip';

const a = trip.accommodation;
---

<Base title="Logistics">
  <div class="space-y-4">
    <Card>
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs uppercase tracking-wider text-[color:var(--color-muted)]">Stay</p>
          <p class="mt-1 font-display text-xl">{a.name}</p>
          <p class="mt-0.5 text-sm text-[color:var(--color-muted)]">{a.address}</p>
        </div>
        {a.mapsUrl && (
          <a
            href={a.mapsUrl}
            class="shrink-0 rounded-full border border-[color:var(--color-line)] px-3 py-1 text-xs text-[color:var(--color-accent)] hover:border-[color:var(--color-accent-soft)]"
          >
            Maps ↗
          </a>
        )}
      </div>
    </Card>

    <Card>
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-muted)]">Flights</p>
      <p class="mt-1 text-sm text-[color:var(--color-muted)]">TBD</p>
    </Card>
  </div>
</Base>
