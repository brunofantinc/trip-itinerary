---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { trip } from '../data/trip';

const stay = trip.accommodation;
const airport = {
  name: 'Lisbon Airport (LIS)',
  address: 'Alameda das Comunidades Portuguesas, 1700-111 Lisboa',
  mapsUrl: 'https://maps.apple.com/?q=Aeroporto%20Humberto%20Delgado%20Lisboa',
};
---

<Base title="Logistics">
  <div class="space-y-4">
    <Card>
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-muted)]">Stay</p>
      <p class="mt-1 font-display text-xl">{stay.name}</p>
      <p class="mt-0.5 text-sm text-[color:var(--color-muted)] select-all break-words">{stay.address}</p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <button
          type="button"
          data-copy={stay.address}
          class="copy-btn rounded-full border border-[color:var(--color-line)] px-3 py-1 text-[color:var(--color-ink)] hover:border-[color:var(--color-accent-soft)]"
        >
          Copy address
        </button>
        {stay.mapsUrl && (
          <a
            href={stay.mapsUrl}
            class="rounded-full border border-[color:var(--color-line)] px-3 py-1 text-[color:var(--color-accent)] hover:border-[color:var(--color-accent-soft)]"
          >
            Maps ↗
          </a>
        )}
      </div>
    </Card>

    <Card>
      <p class="text-xs uppercase tracking-wider text-[color:var(--color-muted)]">Airport</p>
      <p class="mt-1 font-display text-xl">{airport.name}</p>
      <p class="mt-0.5 text-sm text-[color:var(--color-muted)] select-all break-words">{airport.address}</p>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <button
          type="button"
          data-copy={airport.address}
          class="copy-btn rounded-full border border-[color:var(--color-line)] px-3 py-1 text-[color:var(--color-ink)] hover:border-[color:var(--color-accent-soft)]"
        >
          Copy address
        </button>
        <a
          href={airport.mapsUrl}
          class="rounded-full border border-[color:var(--color-line)] px-3 py-1 text-[color:var(--color-accent)] hover:border-[color:var(--color-accent-soft)]"
        >
          Maps ↗
        </a>
      </div>
    </Card>

  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');
  buttons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied ✓';
        setTimeout(() => { if (original) btn.textContent = original; }, 1500);
      } catch {
        // Silent fail — user can long-press the (select-all) address text instead.
      }
    });
  });
</script>
