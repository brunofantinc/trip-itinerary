---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/itinerary`, label: 'Itinerary' },
  { href: `${base}/places`, label: 'Places' },
  { href: `${base}/logistics`, label: 'Logistics' },
  { href: `${base}/notes`, label: 'Notes' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const home = base || '/';

interface Props {
  pageTitle?: string;
}
const { pageTitle } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-40 h-14 border-b border-[color:var(--color-accent-soft)]/70 bg-[color:var(--color-accent-soft)]/80 backdrop-blur">
  <div id="cat-lane" class="cat-lane" aria-hidden="true"></div>

  <div class="relative z-10 flex h-full items-center gap-3 px-4">
    <button
      id="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-controls="nav-drawer"
      aria-expanded="false"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[color:var(--color-line)] bg-[color:var(--color-surface)] text-[color:var(--color-ink)] transition hover:border-[color:var(--color-accent-soft)]"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
    {pageTitle && (
      <p class="truncate rounded-full bg-[color:var(--color-accent-soft)] px-3 py-1 font-display text-lg tracking-tight text-[color:var(--color-ink)]">
        {pageTitle}
      </p>
    )}
  </div>
</header>

<style>
  .cat-lane {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  import lottie from 'lottie-web';

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const catFiles = [`${base}/cat-black.json`, `${base}/cat-orange.json`];
  const lane = document.getElementById('cat-lane');

  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  const CAT_WIDTH = 60;

  let stopped = false;
  const media = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (media.matches) stopped = true;

  const runCat = (x: number, path: string) =>
    new Promise<void>((resolve) => {
      if (!lane) return resolve();

      const container = document.createElement('div');
      Object.assign(container.style, {
        position: 'absolute',
        bottom: '0',
        left: `${x}px`,
        width: `${CAT_WIDTH}px`,
        height: '56px',
        pointerEvents: 'none',
        overflow: 'hidden',
      });
      lane.appendChild(container);

      const anim = lottie.loadAnimation({
        container,
        renderer: 'svg',
        loop: false,
        autoplay: true,
        path,
        rendererSettings: { preserveAspectRatio: 'xMidYMax meet' },
      });

      let phase: 'up' | 'down' = 'up';
      anim.addEventListener('complete', () => {
        if (phase === 'up') {
          phase = 'down';
          setTimeout(() => {
            anim.setDirection(-1);
            anim.play();
          }, 800);
        } else {
          anim.destroy();
          container.remove();
          resolve();
        }
      });
    });

  const spawnRound = async () => {
    if (!lane || stopped) return;
    const laneWidth = lane.clientWidth;
    const pickPath = () => catFiles[Math.floor(Math.random() * catFiles.length)];

    // 18% chance to spawn two cats at once, if there's room.
    const wantDouble = Math.random() < 0.18 && laneWidth >= CAT_WIDTH * 2 + 40;

    if (wantDouble) {
      const half = (laneWidth - 16) / 2;
      const x1 = rand(8, 8 + half - CAT_WIDTH);
      const x2 = rand(8 + half, laneWidth - 8 - CAT_WIDTH);
      await Promise.all([runCat(x1, pickPath()), runCat(x2, pickPath())]);
    } else {
      const x = rand(8, Math.max(8, laneWidth - CAT_WIDTH - 8));
      await runCat(x, pickPath());
    }

    setTimeout(spawnRound, rand(4000, 9000));
  };

  setTimeout(spawnRound, 1500);
</script>

<div
  id="nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  hidden
  class="fixed inset-0 z-50"
>
  <div id="nav-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <div class="absolute inset-y-0 left-0 flex w-72 max-w-[85%] flex-col bg-[color:var(--color-surface)] p-6 shadow-2xl">
    <div class="mb-8 mt-1 flex items-center justify-between">
      <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]">Portugal ’26</p>
      <button
        id="nav-close"
        type="button"
        aria-label="Close menu"
        class="flex h-9 w-9 items-center justify-center rounded-full text-[color:var(--color-ink)] hover:bg-[color:var(--color-bg)]"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <ul class="space-y-1">
      {links.map((l) => {
        const target = l.href.replace(/\/$/, '') || '/';
        const isHome = target === home;
        const active = isHome
          ? path === home
          : path === target || path.startsWith(target + '/');
        return (
          <li>
            <a
              href={l.href}
              class:list={[
                'block rounded-lg px-3 py-3 font-display text-2xl transition',
                active
                  ? 'bg-[color:var(--color-accent-soft)] text-[color:var(--color-accent)]'
                  : 'hover:bg-[color:var(--color-bg)]',
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const close = document.getElementById('nav-close');
  const backdrop = document.getElementById('nav-backdrop');

  const open = () => {
    if (!drawer || !toggle) return;
    drawer.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const shut = () => {
    if (!drawer || !toggle) return;
    drawer.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', open);
  close?.addEventListener('click', shut);
  backdrop?.addEventListener('click', shut);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) shut();
  });
</script>
